{
  // Inherit rule config from .markdownlint.json (MD013/MD033/MD041 disabled).
  "config": {
    "extends": ".markdownlint.json"
  },
  // Default glob: lint every .md / .markdown file in the repo.
  "globs": ["**/*.{md,markdown}"],
  // Two independent reasons an entry is here — this list is NOT a mirror
  // of .gitignore: (a) tracked but deliberately unlinted because it's not
  // ours to reformat — original/ is the verbatim 1996 source (273 tracked
  // files); .beads/ is tool-generated by bd, and its README.md has
  // pre-existing MD032 violations we're not fixing on beads' behalf;
  // (b) genuinely gitignored paths — build dirs, .idea, .tmp, the three
  // .punt-labs plugin-state dirs, and node_modules (not in .gitignore, but
  // never committed either).
  // NOTE: .punt-labs/ethos/** is tracked and deliberately NOT ignored —
  // it holds 11 real .md files (personalities/talents/writing-styles)
  // that CI lints today.
  "ignores": [
    "node_modules/**",
    "build/**",
    "build-*/**",
    "cmake-build-*/**",
    "obj-*/**",
    ".tmp/**",
    ".beads/**",
    "original/**",
    "debian/xboing/**",
    ".idea/**",
    ".punt-labs/quarry/**",
    ".punt-labs/vox/**",
    ".punt-labs/local/**"
  ]
}
